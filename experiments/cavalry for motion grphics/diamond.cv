  {
   "attributes": {
    "array": {
     "list": [
      { "instanceName": "n0", "value": 0.0, "varType": "double" }
     ]
    },
    "colorId": { "value": 0, "varType": "int" },
    "expression": { "value": "// Brilliant-cut diamond — procedural 3D facets, rendered per frame.\n// n0 = frame (from a Frame behaviour). MODE 0 = body, 1 = glints.\nvar MODE = 0;\nvar F = n0;\nvar LOOP = 250;                       // 8-fold symmetry: 90deg spin per loop = seamless\nvar TAU = Math.PI * 2;\nvar RPX = 360;                        // girdle radius in px\nvar EYE = 8.5;                        // camera distance (girdle radii)\nvar spin = F / LOOP * Math.PI / 2;\nvar tilt = (13 + 3 * Math.sin(F / LOOP * TAU)) * Math.PI / 180;\n\nfunction vtx(r, a, y) {\n    var ang = a + spin;\n    var x = r * Math.cos(ang), z = r * Math.sin(ang);\n    return [x, y * Math.cos(tilt) - z * Math.sin(tilt) + 0.25, y * Math.sin(tilt) + z * Math.cos(tilt)];\n}\nfunction sub(a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }\nfunction dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }\nfunction nrm(a) { var l = Math.sqrt(dot(a, a)) || 1; return [a[0] / l, a[1] / l, a[2] / l]; }\nfunction clamp01(x) { return Math.max(0, Math.min(1, x)); }\nfunction smooth(e0, e1, x) { var t = clamp01((x - e0) / (e1 - e0)); return t * t * (3 - 2 * t); }\nfunction hsv(h, s, v) {\n    h = ((h % 360) + 360) % 360 / 60;\n    var i = Math.floor(h), f = h - i, p = v * (1 - s), q = v * (1 - s * f), t = v * (1 - s * (1 - f));\n    return [[v, t, p], [q, v, p], [p, v, t], [p, q, v], [t, p, v], [v, p, q]][i % 6];\n}\nfunction h2(x) { var s = Math.round(clamp01(x) * 255).toString(16); return s.length < 2 ? \"0\" + s : s; }\nfunction hex(c, a) { return \"#\" + h2(a) + h2(c[0]) + h2(c[1]) + h2(c[2]); }   // Cavalry reads 8-digit hex as AARRGGBB\n\nfunction faces() {\n    var f = [], st = TAU / 8, h = st / 2;\n    var tR = 0.56, tY = 0.34, sR = 0.80, gT = 0.025, gB = -0.025, qR = 0.22, cY = -0.86;\n    var sY = tY - (sR - tR) / (1 - tR) * (tY - gT);\n    var qY = gB - (1 - qR) * (gB - cY);\n    var table = [];\n    for (var k = 0; k < 8; k++) table.push(vtx(tR, k * st, tY));\n    f.push(table);\n    var C = vtx(0, 0, cY);\n    for (var k = 0; k < 8; k++) {\n        var a = k * st;\n        var T0 = vtx(tR, a, tY), T1 = vtx(tR, a + st, tY);\n        var S0 = vtx(sR, a + h, sY), Sm = vtx(sR, a - h, sY);\n        var G0 = vtx(1, a, gT), Gh = vtx(1, a + h, gT), G1 = vtx(1, a + st, gT);\n        var B0 = vtx(1, a, gB), Bh = vtx(1, a + h, gB), B1 = vtx(1, a + st, gB);\n        var Q0 = vtx(qR, a + h, qY), Qm = vtx(qR, a - h, qY);\n        f.push([T0, T1, S0]);                 // star\n        f.push([G0, S0, T0, Sm]);             // kite (bezel)\n        f.push([G0, Gh, S0]); f.push([Gh, G1, S0]);   // upper girdle\n        f.push([G0, Gh, Bh, B0]); f.push([Gh, G1, B1, Bh]); // girdle band\n        f.push([B0, Bh, Q0]); f.push([Bh, B1, Q0]);   // lower girdle\n        f.push([B0, Q0, C, Qm]);              // pavilion main\n    }\n    return f;\n}\n\n// Studio environment: softboxes on a Fibonacci sphere with hashed strengths.\nfunction hash(i) { var x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }\nvar LIGHTS = [];\nfor (var li = 0; li < 14; li++) {\n    var yy = 1 - 2 * (li + 0.5) / 14, rr = Math.sqrt(1 - yy * yy), th = li * 2.39996;\n    var w = hash(li) < 0.3 ? 0.15 : 0.7 + 0.9 * hash(li + 50);\n    LIGHTS.push([rr * Math.cos(th), yy, rr * Math.sin(th), w, 10 + 30 * hash(li + 99)]);\n}\nfunction env(d) {\n    var I = 0.04 + 0.22 * Math.max(0, d[1]);\n    for (var i = 0; i < LIGHTS.length; i++) {\n        var L = LIGHTS[i];\n        I += L[3] * Math.pow(Math.max(0, d[0] * L[0] + d[1] * L[1] + d[2] * L[2]), L[4]);\n    }\n    return I;\n}\n\nfunction project(p) { var s = EYE / (EYE - p[2]); return [p[0] * s * RPX, p[1] * s * RPX]; }\nfunction polyPath(v) {\n    var path = new cavalry.Path(), p = project(v[0]);\n    path.moveTo(p[0], p[1]);\n    for (var i = 1; i < v.length; i++) { p = project(v[i]); path.lineTo(p[0], p[1]); }\n    path.close();\n    return path;\n}\nfunction starPath(cx, cy, L, w, rot) {\n    var path = new cavalry.Path();\n    for (var i = 0; i < 8; i++) {\n        var a = rot + i * Math.PI / 4, r = (i % 2 == 0) ? L : w;\n        var x = cx + r * Math.cos(a), y = cy + r * Math.sin(a);\n        if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);\n    }\n    path.close();\n    return path;\n}\n\nfunction build() {\n    var fs = faces(), O = vtx(0, 0, -0.25), E = [0, 0, EYE];\n    var back = [], front = [];\n    for (var i = 0; i < fs.length; i++) {\n        var v = fs[i], c = [0, 0, 0], n = [0, 0, 0];\n        for (var j = 0; j < v.length; j++) {\n            var A = v[j], B = v[(j + 1) % v.length];\n            n[0] += (A[1] - B[1]) * (A[2] + B[2]); n[1] += (A[2] - B[2]) * (A[0] + B[0]); n[2] += (A[0] - B[0]) * (A[1] + B[1]);\n            c[0] += A[0] / v.length; c[1] += A[1] / v.length; c[2] += A[2] / v.length;\n        }\n        n = nrm(n);\n        if (dot(n, sub(c, O)) < 0) n = [-n[0], -n[1], -n[2]];\n        var V = nrm(sub(E, c)), nv = dot(n, V);\n        var item = { v: v, c: c, n: n, i: i };\n        if (nv > 0) {\n            var R = [2 * nv * n[0] - V[0], 2 * nv * n[1] - V[1], 2 * nv * n[2] - V[2]];\n            item.I = env(R); item.R = R; front.push(item);\n        } else {\n            var d = nrm([n[0] * 0.8, n[1], -n[2] + 0.4]);\n            item.I = env(d) * 0.9; item.R = d; back.push(item);\n        }\n    }\n    var mesh = new cavalry.Mesh();\n    var hueT = 360 * F / LOOP;\n\n    if (MODE == 0) {\n        var groups = [[back, true], [front, false]];\n        for (var g = 0; g < 2; g++) {\n            var list = groups[g][0], isBack = groups[g][1];\n            for (var k = 0; k < list.length; k++) {\n                var it = list[k], R = it.R, Ic = smooth(0.18, 0.85, it.I);\n                var wave = 0.5 + 0.5 * Math.sin(dot(R, [3.1, 2.3, 1.7]) * 4.0 + it.i * 1.7 + F / LOOP * TAU);\n                var fire = isBack ? 0.15 + 0.5 * smooth(0.45, 0.95, wave) : 0.55 * smooth(0.72, 0.98, wave);\n                var hue = Math.atan2(R[1], R[0]) * 360 / TAU * 2 + hueT + it.i * 23;\n                var rb = hsv(hue, 0.7, 1);\n                var base = [0.86, 0.93, 1.0], dark = [0.035, 0.06, 0.13];\n                var col = [];\n                for (var ch = 0; ch < 3; ch++) col.push(dark[ch] + ((1 - fire) * base[ch] + fire * rb[ch]) * Ic * (isBack ? 0.8 : 1));\n                var m = new cavalry.Material();\n                m.fill = true;\n                m.fillColor = hex(col, isBack ? 1 : 0.3 + 0.7 * Ic);\n                m.stroke = true;\n                m.strokeWidth = isBack ? 0.8 : 1.1;\n                m.strokeColor = isBack ? hex([0.7, 0.85, 1], 0.10) : hex([1, 1, 1], 0.22 + 0.45 * Ic);\n                mesh.addPath(polyPath(it.v), m);\n            }\n        }\n    } else {\n        front.sort(function (a, b) { return b.I - a.I; });\n        for (var k = 0; k < Math.min(5, front.length); k++) {\n            var it = front[k], amt = smooth(0.82, 1.2, it.I);\n            if (amt <= 0.01) continue;\n            var p = project(it.c), L = 95 * amt;\n            var m = new cavalry.Material();\n            m.fill = true; m.fillColor = hex([1, 1, 1], 0.95);\n            mesh.addPath(starPath(p[0], p[1], L, L * 0.07, Math.PI / 2), m);\n            var m2 = new cavalry.Material();\n            m2.fill = true; m2.fillColor = hex([0.85, 0.92, 1], 0.7);\n            mesh.addPath(starPath(p[0], p[1], L * 0.42, L * 0.06, Math.PI / 4 + Math.PI / 2), m2);\n            var m3 = new cavalry.Material();\n            m3.fill = true; m3.fillColor = hex([1, 1, 1], 1);\n            var core = new cavalry.Path(); core.addEllipse(p[0], p[1], L * 0.09, L * 0.09);\n            mesh.addPath(core, m3);\n        }\n    }\n    return mesh;\n}\n\nbuild();\n", "varType": "string" },
    "niceName": { "value": "JavaScript Utility", "varType": "string" },
    "showInProjectWindow": { "value": false, "varType": "bool" },
